{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--loader ./scripts/alias-loader.mjs' LOG_DIR=./logs tsx watch src/index.ts",
    "build": "tsc && tsc-alias --resolve-full-paths && node scripts/build-post.mjs",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.3",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.2",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.11.0",
    "minio": "^8.0.4",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "cross-env": "^10.1.0",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@fastify/static": "9.0.0"
  }
}
